#!/usr/bin/env python3
"""Collect what the acceptance gate judges: the approved requirements, the spec's examples, the acceptance tests and
their results, the run from before the work, and the fingerprints of the oracle.

    collect REPO OUT        write OUT/requirements.json, examples.json, tests.json, results.json, current.json,
                            and copy red-before.json and oracle.json from this loop's folder
    collect REPO --record   run the acceptance tests before the work and record that run (red-before.json) and the
                            fingerprints of the spec and the tests (oracle.json) in this loop's folder

The tests are the Go tests in REPO/acceptance; the line before each test function is `// example: <slice>/<name>`.
The spec comes through ops/spec (em.py export) and the requirement files under specs/requirements/. Needs Python 3,
PyYAML and Go.
"""
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys

import yaml

HERE = pathlib.Path(__file__).resolve().parent  # this code; the evidence lives in REPO/loops/acceptance
TAG = re.compile(r"^// example: (.+?)\s*\nfunc (Test\w+)\(", re.M)


def oracle_files(repo):
    """The files a person approved: the spec, and the acceptance tests once they are written."""
    files = sorted(p for p in (repo / "specs").rglob("*") if p.is_file())
    files += sorted((repo / "acceptance").glob("*_test.go"))
    return files


def fingerprints(repo):
    return {str(p.relative_to(repo)): hashlib.sha256(p.read_bytes()).hexdigest() for p in oracle_files(repo)}


def tests(repo):
    """{test function: example id} from the tags in acceptance/*_test.go."""
    out = {}
    for p in sorted((repo / "acceptance").glob("*_test.go")):
        for example, name in TAG.findall(p.read_text(encoding="utf-8")):
            out[name] = example
    return out


def results(repo):
    """{test function: pass | fail} of one run of the acceptance tests."""
    run = subprocess.run(["go", "test", "./acceptance/", "-count=1", "-json"], cwd=repo, capture_output=True, text=True)
    out = {}
    for line in run.stdout.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        name = e.get("Test") or ""
        if name and "/" not in name and e.get("Action") in ("pass", "fail", "skip"):
            out[name] = e["Action"]
        elif not name and e.get("Action") in ("pass", "fail", "skip"):
            out["(package)"] = e["Action"]  # the binary's own verdict: forged test lines cannot make it pass
    if not out and run.returncode:
        out["(build)"] = "fail"
        sys.stderr.write(run.stdout[-2000:] + run.stderr[-2000:])
    return out


def examples(repo):
    """{example id: [requirement ids]} of every e2e-ready example of the spec, from em.py export. With SPEC_PLUGIN set
    (in CI), the plugin runs directly, so no script of the repository under test runs here."""
    plugin = os.environ.get("SPEC_PLUGIN")
    cmd = ([sys.executable, str(pathlib.Path(plugin) / "skills" / "event-model" / "scripts" / "em.py")] if plugin
           else [str(repo / "ops" / "spec"), "em"]) + ["export", "specs/model/"]
    run = subprocess.run(cmd, cwd=repo, capture_output=True, text=True, check=True)
    doc = json.loads(run.stdout)
    return {"%s/%s" % (e["slice"], e["name"]): sorted(set(e.get("reqs") or []))
            for e in doc["examples"] if e.get("e2e_ready")}


def requirements(repo):
    out = {}
    for p in sorted((repo / "specs" / "requirements").glob("*.y*ml")):
        doc = yaml.safe_load(p.read_text(encoding="utf-8")) or {}
        for r in doc.get("requirements") or []:
            out[r["id"]] = {"status": doc.get("status"), "kind": r.get("kind"), "text": r.get("text", "")}
    return out


def write(path, data):
    path.write_text(json.dumps(data, indent=1, sort_keys=True, ensure_ascii=False) + "\n", encoding="utf-8")


def main(argv):
    if len(argv) != 3:
        sys.exit(__doc__)
    repo = pathlib.Path(argv[1]).resolve()
    evidence = repo / "loops" / "acceptance"
    if argv[2] == "--record":
        run = results(repo)
        write(evidence / "red-before.json", run)
        write(evidence / "oracle.json", fingerprints(repo))
        print("recorded the run before the work (%d tests: %s) and the oracle (%d files)"
              % (len(run), ", ".join("%s %d" % (k, list(run.values()).count(k)) for k in sorted(set(run.values()))),
                 len(fingerprints(repo))))
        return 0
    out = pathlib.Path(argv[2])
    out.mkdir(parents=True, exist_ok=True)
    write(out / "requirements.json", requirements(repo))
    write(out / "examples.json", examples(repo))
    write(out / "tests.json", tests(repo))
    write(out / "results.json", results(repo))
    write(out / "current.json", fingerprints(repo))
    for name in ("red-before.json", "oracle.json"):
        src = evidence / name
        write(out / name, json.loads(src.read_text(encoding="utf-8")) if src.exists() else {})
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
