#!/usr/bin/env python3
"""Collect what the maintenance gate judges: the files a change touches, and its measure before and after.

    collect REPO BASE OUT     write OUT/changes.json and OUT/measure.json

The change is BASE...HEAD of REPO. The measure is the days of support left of the runtimes (loops/runtime-eol):
the fewest over the runtimes, at BASE and at HEAD, where a runtime with no end of life announced counts as unlimited.
Needs the history down to BASE (in CI, fetch-depth: 0). Standard library only; Python 3.9.
"""
import datetime
import json
import pathlib
import subprocess
import sys
import tempfile

EOL = pathlib.Path(__file__).resolve().parent.parent / "runtime-eol" / "collect"


def git(repo, *args):
    return subprocess.run(["git", "-C", str(repo)] + list(args), capture_output=True, text=True, check=True).stdout


def support(repo, out):
    subprocess.run([sys.executable, str(EOL), str(repo), str(out)], check=True)
    runtimes = json.loads((out / "runtimes.json").read_text(encoding="utf-8"))
    today = datetime.date.fromisoformat(json.loads((out / "today.json").read_text(encoding="utf-8"))["today"])
    lefts, detail = [], []
    for r in runtimes:
        eol = r.get("eol")
        left = None if eol in (False, None) else (datetime.date.fromisoformat(str(eol)) - today).days
        detail.append("%s %s: %s" % (r["name"], r["cycle"], "no end of life announced" if left is None
                                     else "%d days" % left))
        if left is not None:
            lefts.append(left)
    return {"value": min(lefts) if lefts else None, "detail": detail}


def main(argv):
    if len(argv) != 4:
        sys.exit(__doc__)
    repo, base, out = pathlib.Path(argv[1]).resolve(), argv[2], pathlib.Path(argv[3])
    changes = git(repo, "diff", "--name-only", "%s...HEAD" % base).split()
    with tempfile.TemporaryDirectory() as tmp:
        worktree = pathlib.Path(tmp) / "base"
        git(repo, "worktree", "add", "--detach", "--quiet", str(worktree), base)
        try:
            before = support(worktree, pathlib.Path(tmp) / "before")
        finally:
            git(repo, "worktree", "remove", "--force", str(worktree))
        after = support(repo, pathlib.Path(tmp) / "after")
    out.mkdir(parents=True, exist_ok=True)
    (out / "changes.json").write_text(json.dumps(changes, indent=1) + "\n", encoding="utf-8")
    (out / "measure.json").write_text(json.dumps({"name": "days of support left of the runtimes",
                                                  "before": before, "after": after}, indent=1) + "\n",
                                      encoding="utf-8")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
