#!/usr/bin/env python3
"""The gate of maintenance: a change that keeps the behaviour and improves its measure.

    run SNAPSHOT_DIR     (OUT of collect: changes.json, measure.json)

Fires on a changed test, acceptance test, spec, snapshot or golden file: an expected value changed, so this is not
maintenance and goes back to triage. Fires when the measure did not improve. Exit 0 when the change is invariant
and the measure improved. Standard library only; Python 3.9.
"""
import json
import pathlib
import re
import sys

EXPECTED = re.compile(r"(_test\.go$|^acceptance/|^specs/|/testdata/|__snapshots__/|\.golden$|\.(test|spec)\.[jt]sx?$)")


GATES = re.compile(r"^(loops/|\.github/)")


def compare(before, after):
    """(improved, problems): the same runtimes before and after, every one known, and the fewest days of support
    left grown. None is unlimited, and counts only when endoflife.date announces no end of life."""
    problems = []
    if set(before["runtimes"]) != set(after["runtimes"]):
        problems.append("the runtimes differ: before %s, after %s" % (sorted(before["runtimes"]),
                                                                       sorted(after["runtimes"])))
    for name, r in sorted(after["runtimes"].items()):
        if r["days"] == "unknown":
            problems.append("%s %s is unknown to endoflife.date" % (name, r["cycle"]))
    if problems:
        return False, problems

    def fewest(m):
        known = [r["days"] for r in m["runtimes"].values() if r["days"] is not None]
        return min(known) if known else None
    b, a = fewest(before), fewest(after)
    return b is not None and (a is None or a > b), []


def main(argv):
    if len(argv) != 2:
        sys.exit(__doc__)
    d = pathlib.Path(argv[1])
    try:
        changes = json.loads((d / "changes.json").read_text(encoding="utf-8"))
        measure = json.loads((d / "measure.json").read_text(encoding="utf-8"))
        before, after = measure["before"], measure["after"]
        before["runtimes"], after["runtimes"]
    except (OSError, ValueError, KeyError) as e:
        print("snapshot: broken — %s" % e)
        return 2
    failed = False
    for f in changes:
        if EXPECTED.search(f):
            failed = True
            print("expected value changed: %s — this is not maintenance; back to triage" % f)
    line = "%s: %s → %s" % (measure["name"], "; ".join(before["detail"]), "; ".join(after["detail"]))
    improved, problems = compare(before, after)
    for p in problems:
        print("measure unknown — %s" % p)
    if improved:
        print("measure improved — %s" % line)
    else:
        failed = True
        print("measure not improved — %s" % line)
    for f in changes:
        if GATES.search(f):
            print("note: %s is part of the gates: a person reviews it; this gate runs as the base has it" % f)
    if not failed:
        print("invariant: %d files changed, none of them a test, a spec or an expected value" % len(changes))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
